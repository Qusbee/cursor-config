{
  "workbench.colorTheme": "Monokai Pro",
  "workbench.activityBar.location": "hidden",
  "workbench.editor.showTabs": "single", // Приховує вкладки
  "workbench.statusBar.visible": false,
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": true,
  "editor.minimap.enabled": false, // Вимикає міні-карту
  "breadcrumbs.enabled": false,
  "workbench.sideBar.location": "right",
  "workbench.iconTheme": "catppuccin-frappe",
  "catppuccin-icons.hidesExplorerArrows": true,
  "catppuccin-icons.specificFolders": true,
  "catppuccin-icons.monochrome": false,
  // "workbench.tree.enableStickyScroll": false, Вимикає закріплення папок при скролі
  "workbench.tree.renderIndentGuides": "none",
  "workbench.tree.indent": 8, // Відступ в структурі папок
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false, // Підтвердження для переміщення файлів
  "explorer.confirmDelete": false, // Підтвердження видалення файлів
  "explorer.decorations.badges": false,
  "git.decorations.enabled": false,
  "window.zoomLevel": 1,
  "custom-ui-style.font.sansSerif": "Dank Mono",
  "custom-ui-style.stylesheet": {
    ".title .label-description": "font-style: italic;",
    ".label-description": "font-style: italic;",
    ".pane-header": "display: none !important;",
    ".notification-toast": "box-shadow: none !important;",
    ".quick-input-widget.show-file-icons": "box-shadow: none !important",
    ".quick-input-widget": "top: 25vh !important;",
    ".quick-input-list .scrollbar": "display: none",
    ".monaco-action-bar.quick-input-inline-action-bar": "display: none",
    ".editor-widget.find-widget": "box-shadow: none; border-radius: 4px",
    ".monaco-scrollable-element > .shadow.top": "display: none",
    ".sidebar .title-label": "padding: 0 !important",
    ".sidebar": "border: none !important",
    ".monaco-workbench .monaco-list:not(.element-focused):focus:before": "outline: none !important",
    ".monaco-list-row.focused": "outline: none !important",
    ".monaco-editor .scroll-decoration": "display: none",
    ".title-actions": "display: none !important",
    ".title.show-file-icons .label-container .monaco-icon-label.file-icon": "justify-content: center; padding: 0 !important",
    ".title .monaco-icon-label:after": "margin-right: 0",
    ".titlebar-agents-icon": "display: none !important;",
    ".action-label.codicon-add-two": "display: none !important;",
    ".navigation-actions-container-in-titlebar": "display: none !important;",
    ".action-label.codicon-panel-layout-icon-off": "display: none !important;",
    ".action-label.codicon-panel-right-off": "display: none !important;",
    ".action-label.codicon-settings-gear": "display: none !important;",
    ".upgrade-pro-button-text": "display: none !important;",
    "*:has(> .upgrade-pro-button-text)": "display: none !important;",
    ".monaco-editor .cursors-layer .cursor": "background-image: linear-gradient(135deg, #FFD866 10%, #FC9867 100%); border-radius: 3px;",
    ".titlebar": "background-color: #181818 !important;",
    ".monaco-workbench .part.titlebar": "background-color: #181818 !important;",
    ".title.show-file-icons": "background-color: #181818 !important;"
  },
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.cursorBlinking": "phase",
  "editor.cursorWidth": 3,
  "editor.cursorStyle": "line",
  "workbench.colorCustomizations": {
    "quickInput.background": "#000000",
    "quickInputList.focusBackground": "#1a1a1a",
    "pickerGroup.border": "#3a3a3a",
    "pickerGroup.foreground": "#3a3a3a",
    "editor.background": "#181818",
    "sideBar.background": "#181818",
    "activityBar.background": "#181818",
    "panel.background": "#181818",
    "titleBar.activeBackground": "#181818",
    "titleBar.inactiveBackground": "#181818",
    "statusBar.background": "#181818",
    "tab.activeBackground": "#181818",
    "tab.inactiveBackground": "#181818",
    "editorGroupHeader.tabsBackground": "#181818",
    "sideBarSectionHeader.background": "#181818",
    "input.background": "#181818",
    "dropdown.background": "#181818",
    "editorGutter.background": "#181818",
    "editorWidget.background": "#181818",
    "editorOverviewRuler.wordHighlightStrongForeground": "#0000",
    "editorOverviewRuler.selectionHighlightForeground": "#0000",
    "editorOverviewRuler.rangeHighlightForeground": "#0000",
    "editorOverviewRuler.wordHighlightForeground": "#0000",
    "editorOverviewRuler.bracketMatchForeground": "#0000",
    "editorOverviewRuler.findMatchForeground": "#0000",
    "editorOverviewRuler.modifiedForeground": "#0000",
    "editorOverviewRuler.deletedForeground": "#0000",
    "editorOverviewRuler.warningForeground": "#0000",
    "editorOverviewRuler.addedForeground": "#0000",
    "editorOverviewRuler.errorForeground": "#0000",
    "editorOverviewRuler.infoForeground": "#0000",
    "editorOverviewRuler.border": "#0000"
  },
  "editor.fontFamily": "Dank Mono",
  "editor.fontSize": 15,
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.7,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "comment",
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  },
  "editor.stickyScroll.enabled": false,
  "editor.codeLens": false,
  "editor.links": false,
  "editor.matchBrackets": "never",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  // "scm.diffDecorations": "none",
  "editor.detectIndentation": false,
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.quickSuggestions": {
    "other": "off"
  },
  "editor.suggestOnTriggerCharacters": false,
  "editor.tabCompletion": "on",
  "editor.snippetSuggestions": "top",
  "emmet.triggerExpansionOnTab": true,
  "update.mode": "none",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.guides.indentation": false,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "window.restoreWindows": "none",
  // "files.hotExit": "off",
}
